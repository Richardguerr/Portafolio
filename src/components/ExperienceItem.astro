---
import LinkInline from "./LinkInline.astro";

interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
}

const { title, company, description, link, date } = Astro.props;
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4 group hover:transform hover:scale-[1.02] transition-all duration-300"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span
        class="text-yellow-400 -left-[42px] absolute rounded-full text-5xl group-hover:text-yellow-300 transition-colors"
        >&bull;</span
      >
      <h3
        class="text-xl font-bold text-yellow-400 group-hover:text-yellow-300 transition-colors"
      >
        {title}
      </h3>
      <h4 class="font-semibold text-xl text-gray-600 dark:text-white mt-1">
        {company}
      </h4>
      <time
        class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80 bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full inline-block mt-2"
        >{date}</time
      >
    </div>
  </div>
  <div
    class="relative flex flex-col gap-4 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3"
  >
    <div class="space-y-3">
      {
        description.split("\n\n").map((paragraph, index) => (
          <p class={`${index === 0 ? "text-lg leading-relaxed" : "text-base"}`}>
            {paragraph.split("\n").map((line) => (
              <span class="block">
                {line.startsWith("•") ? (
                  <span class="flex items-start gap-2">
                    <span class="text-yellow-400 mt-1.5 flex-shrink-0">▶</span>
                    <span>{line.slice(1)}</span>
                  </span>
                ) : (
                  line
                )}
              </span>
            ))}
          </p>
        ))
      }
    </div>
    {
      link && (
        <LinkInline href={link}>
          Ver detalles del proyecto{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right group-hover:translate-x-1 transition-transform"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
