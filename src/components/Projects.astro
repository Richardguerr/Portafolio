---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import Link from "./icons/Link.astro";
import Python from "./icons/Python.astro";
import FastAPI from "./icons/FastApi.astro";
import Go from "./icons/Go.astro";
import ReactIcon from "./icons/React.astro";
import IoT from "./icons/Iot.astro";
import Docker from "./icons/Docker.astro";
import LinkButton from "./LinkButton.astro";
import Microservices from "./icons/Microservices.astro";
import Unity from "./icons/Unity.astro";
import Csharps from "./icons/Csharps.astro";
import Threed from "./icons/Threed.astro";
const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#38B2AC] text-white",
    icon: Tailwind,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white",
    icon: Python,
  },
  FASTAPI: {
    name: "FastAPI",
    class: "bg-[#009485] text-white",
    icon: FastAPI,
  },
  GO: {
    name: "Go",
    class: "bg-[#00ADD8] text-white",
    icon: Go,
  },
  REACT: {
    name: "React",
    class: "bg-[#61DAFB] text-black",
    icon: ReactIcon,
  },
  IOT: {
    name: "IoT",
    class: "bg-[#FF6B35] text-white",
    icon: IoT,
  },
  MICROSERVICES: {
    name: "Microservicios",
    class: "bg-[#8B5CF6] text-white",
    icon: Microservices,
  },
  DOCKER: {
    name: "Docker",
    class: "bg-[#2496ED] text-white",
    icon: Docker,
  },
  UNITY: {
    name: "Unity",
    class: "bg-[#000000] text-white",
    icon: Unity,
  },
  CSHARP: {
    name: "C#",
    class: "bg-[#9B4993] text-white",
    icon: Csharps,
  },
  THREED: {
    name: "3D",
    class: "bg-[#FF6B35] text-white",
    icon: Threed,
  },
};

const PROJECTS = [
  {
    title: "Melollevo - Plataforma de Subastas en Línea",
    description:
      "Plataforma de subastas en tiempo real desarrollada con tecnologías modernas. Sistema completo con módulos administrativos y de clientes.",
    link: "https://www.melollevo.com.co/subastas/inicio",
    image: "/projects/melollevo.png", // Verifica que esta imagen existe
    tags: [
      TAGS.NEXT,
      TAGS.TAILWIND,
      TAGS.REACT,
      TAGS.PYTHON,
      TAGS.FASTAPI,
      TAGS.DOCKER,
    ],
  },
  {
    title: "Iot Mine System - Plataforma IoT para Minería Subterránea",
    description:
      "Sistema de monitoreo en tiempo real para labores mineras subterráneas basado en arquitectura de microservicios. Desarrollé una solución integral que recopila, procesa y visualiza datos críticos de seguridad y operación mediante dispositivos IoT.",
    link: "https://iot-system-uptc.duckdns.org/login",
    github: "https://github.com/wFercho/base_microservices_proyecto_grado",
    image: "/projects/iotminesystem2.png", // Cambié a una ruta más lógica
    tags: [
      TAGS.PYTHON,
      TAGS.FASTAPI,
      TAGS.GO,
      TAGS.REACT,
      TAGS.TAILWIND,
      TAGS.IOT,
      TAGS.MICROSERVICES,
    ],
  },
  {
    title: "Car Hub - Galería de Carros",
    description:
      "Galería de carros importando imágenes y diseños a través de APIs. Creado desde cero con Next.js, React y Tailwind CSS.",
    link: "https://car-hub-tan-xi.vercel.app/",
    github: "https://github.com/Richardguerr/Car_Hub",
    image: "/projects/carhub.png", // Cambié el nombre para consistencia
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.REACT],
  },
  {
    title: "Survival - Videojuego 3D Educativo",
    description:
      "Videojuego educativo en 3D desarrollado con Unity y C#, diseñado para enseñar conceptos de supervivencia y resolución de problemas en entornos virtuales inmersivos. El juego combina mecánicas de aventura con elementos educativos interactivos.\n\n" +
      "Proyecto que demuestra la capacidad de combinar desarrollo de videojuegos con objetivos educativos.",
    github: "https://github.com/Richardguerr/VideoGame_Survival",
    image: "/projects/survival.png",
    tags: [TAGS.UNITY, TAGS.CSHARP, TAGS.THREED],
  },
];
---


<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-2xl overflow-clip rounded-2xl sm:rounded-2xl md:group-hover:-translate-y-2 md:group-hover:shadow-3xl lg:border-2 lg:border-gray-300/20 dark:lg:border-gray-600/30 lg:hover:border-yellow-400/30 lg:bg-gradient-to-br lg:from-gray-50/50 lg:to-white/30 dark:lg:from-gray-800/50 dark:lg:to-gray-900/30 lg:hover:bg-gray-100/50 dark:lg:hover:bg-gray-800/50">
            
            <!-- Efecto de overlay al hover -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 rounded-2xl"></div>
            
            <!-- Badge de proyecto -->
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-yellow-400 text-black text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                Proyecto
              </span>
            </div>
            
            <img
              alt={title}
              class="object-cover object-center w-full h-64 transition-all duration-700 sm:h-full md:scale-105 md:group-hover:scale-100 md:group-hover:brightness-110"
              loading="lazy"
              src={image}
              width="600"
              height="400"
            />
            
            <!-- Efecto de brillo al hover -->
            <div class="absolute inset-0 bg-yellow-400/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl mix-blend-overlay"></div>
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-3xl font-bold text-gray-800 dark:text-gray-100 mb-3 bg-gradient-to-r from-yellow-400 to-yellow-600 bg-clip-text text-transparent">
            {title}
          </h3>
          
          <div class="flex flex-col gap-6">
            <ul class="flex flex-row flex-wrap gap-3">
              {tags.map((tag) => (
                <li class="group/tag">
                  <span
                    class={`flex items-center gap-x-2 rounded-full text-xs font-medium ${tag.class} py-2 px-4 transition-all duration-300 group-hover/tag:scale-105 group-hover/tag:shadow-lg border border-transparent group-hover/tag:border-white/20`}
                  >
                    <tag.icon class="size-4 transition-transform group-hover/tag:scale-110" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="text-gray-700 dark:text-gray-300 leading-relaxed text-lg font-light">
              {description.split('\n\n').map((paragraph, index) => (
                <p class={`mb-4 ${index === 0 ? 'text-xl font-normal' : ''}`}>
                  {paragraph}
                </p>
              ))}
            </div>

            <footer class="flex items-end justify-start gap-4 mt-4">
              {github && (
                <LinkButton 
                  href={github} 
                  target="_blank"
                  class="group/btn bg-gray-800 hover:bg-gray-900 dark:bg-gray-700 dark:hover:bg-gray-600 text-white px-6 py-3 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl"
                >
                  <GitHub class="size-5 group-hover/btn:scale-110 transition-transform" />
                  <span class="font-semibold">Ver Código</span>
                </LinkButton>
              )}
              {link && (
                <LinkButton 
                  href={link} 
                  target="_blank"
                  class="group/btn bg-gradient-to-r from-yellow-400 to-yellow-500 hover:from-yellow-500 hover:to-yellow-600 text-gray-900 px-6 py-3 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl font-semibold"
                >
                  <Link class="size-4 group-hover/btn:scale-110 transition-transform" />
                  <span>Ver Demo</span>
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  /* Efectos adicionales de CSS */
  .shadow-3xl {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }
  
  /* Smooth scrolling para mejor experiencia */
  html {
    scroll-behavior: smooth;
  }
</style>